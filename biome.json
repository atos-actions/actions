{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 120
	},
	"css": {},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"markdown": {
		"analyzeEmbeds": true,
		"formatter": {
			"formatEmbeds": true
		},
		"parser": {
			"frontmatter": true
		}
	},
	"files": {
		"includes": ["**", "!**/.devcontainer", "!CHANGELOG.md"]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
